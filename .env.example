# ------------------------------------------------------------------
# Configuration de l'API Ankkata — copier ce fichier en ".env" pour un
# environnement local hors Docker (docker-compose lit déjà les valeurs
# par défaut définies dans docker-compose.yml, ce fichier sert surtout
# de documentation + de base pour le développement local avec `npm run dev`).
# ------------------------------------------------------------------

# Serveur
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Base de données (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ankkata
DB_USER=ankkata
DB_PASSWORD=ankkata_secret
DB_SSL=false

# JSON Web Tokens
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Sécurité
BCRYPT_SALT_ROUNDS=10

# Supervision des postes — version actuelle du logiciel guichet à diffuser :
# tout poste qui heartbeat avec une version différente se voit proposer une
# mise à jour (voir src/services/poste.service.js). À incrémenter à chaque
# nouvelle release compilée du logiciel guichet.
LATEST_APP_VERSION=1.0.0

# --- Déploiement production uniquement (voir DEPLOYMENT.md) ---
# Nom de domaine pointé (enregistrement DNS A) vers l'IP du VPS — utilisé par
# Caddy pour obtenir un certificat HTTPS automatique (Let's Encrypt). Laisser
# vide en local ; en test rapide sans domaine, voir DEPLOYMENT.md "Mode simple".
ANKKATA_DOMAIN=

# URL publique du site Voyageur (ankkata_frontend) — utilisée dans les
# SMS/emails de confirmation (lien vers le billet) et dans le QR code du
# billet. En local avec docker-compose du frontend : http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# --- Notifications voyageur (code de connexion OTP + confirmation de réservation) ---
# Canal utilisé : "sms" (par défaut — recommandé pour le Burkina Faso où
# beaucoup de voyageurs n'ont pas d'email), "email", ou "both" pour envoyer
# sur les deux canaux à la fois. Changez cette valeur pour tester chaque
# canal indépendamment.
CANAL_NOTIFICATION=sms

# Fournisseur SMS : "africastalking" (par défaut — pensé pour l'Afrique, couvre
# le Burkina Faso, app "Sandbox" gratuite pour tester sans rien dépenser :
# https://account.africastalking.com/apps/sandbox, texte libre sans étape de
# template), "sent" (sent.dm, API unifiée SMS/WhatsApp/RCS, mais exige de créer
# un template dans son dashboard avant le moindre envoi — voir plus bas), ou
# "twilio" (tarif Burkina Faso publié ~0,2233 $/SMS, plus cher que la moyenne).
SMS_PROVIDER=africastalking

# Sent (sent.dm) — créez un compte sur sent.dm, puis dans son tableau de bord
# (Templates) créez UN SEUL template avec pour corps exactement :
#   {{0:texte}}
# ...et nommez sa variable dynamique "texte" (sinon ajustez
# SENT_TEMPLATE_VARIABLE ci-dessous pour qu'il corresponde). C'est ce même
# template générique qui sert à la fois pour le code de connexion et la
# confirmation de réservation — le texte final est déjà construit côté API,
# Sent ne fait que le transmettre. Copiez la clé API et l'id du template
# depuis le tableau de bord (Dashboard > API Keys / Templates).
SENT_API_KEY=
SENT_TEMPLATE_ID=
SENT_TEMPLATE_VARIABLE=texte

# Africa's Talking — laissez username=sandbox pour tester gratuitement (créez
# un compte sur africastalking.com, l'app "Sandbox" est créée automatiquement
# avec un petit crédit KES offert). Passez AFRICASTALKING_SANDBOX=false et
# renseignez le nom de votre app "Live" + sa clé pour un envoi réel.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SANDBOX=true

# Twilio — voir console.twilio.com (Account SID, Auth Token, et un numéro
# Twilio capable d'envoyer des SMS internationaux).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP (email réel) — n'importe quel fournisseur classique convient (Gmail
# avec un "mot de passe d'application", Brevo/Sendinblue gratuit, Mailtrap
# pour tester sans rien envoyer réellement, OVH, etc.). Laissé vide = l'envoi
# par email échoue proprement (sans jamais bloquer la réservation).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ankkata <no-reply@ankkata.com>"
